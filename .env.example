# Copy to /opt/trading-os/.env on the VPS (chmod 600)

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
POLYGON_API_KEY=
FRED_API_KEY=
TZ=America/New_York

# Web (optional Basic Auth — Caddy can also handle auth)
WEB_BASIC_AUTH_USER=
WEB_BASIC_AUTH_PASS=

# Public URL (for links in UI)
APP_BASE_URL=https://rae-trading.com
